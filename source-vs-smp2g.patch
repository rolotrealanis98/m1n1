 }
 
+/*
+ * smp2h: T6050 has no MCC driver here ("MCC: Unsupported version:mcc,t6050"), so the register path
+ * below never ran and the TZ carveouts stayed in m1n1's Normal-cacheable identity map of all DRAM.
+ * Every EL2 SError seen on this machine (ESR 0xbe000000, L2C_ERR_STS 0x82 = access fault) had
+ * L2C_ERR_ADR[41:0] inside region-id-2 (serror-20261110/ANALYSIS.md). Upstream unmaps the TZ
+ * carveouts for exactly this reason (72788291: "safe from SErrors caused by hitting TZ carveouts"),
+ * and for SoCs without TZ registers takes them from the ADT (d34014b1, region-id-4 and region-id-2).
+ * This is that ADT path, run when the MCC is not initialised on T6050.
+ */
+static const char *const mcc_adt_tz_names[] = {"region-id-4", "region-id-2"};
+
+static int mcc_unmap_adt_tz(void)
+{
+    int node = adt_path_offset(adt, "/chosen/carveout-memory-map");
+
+    if (node < 0) {
+        printf("MMU: no /chosen/carveout-memory-map, TZ carveouts stay mapped\n");
+        return -1;
+    }
+    if (mem_size_actual > (u64)-1 - ram_base)
+        return -1;
+    for (size_t i = 0; i < ARRAY_SIZE(mcc_adt_tz_names); i++) {
+        u32 len;
+        const u64 *range = adt_getprop(adt, node, mcc_adt_tz_names[i], &len);
+        u64 start, size;
+
+        if (!range || len != 2 * sizeof(u64)) {
+            printf("MMU: %s missing, left mapped\n", mcc_adt_tz_names[i]);
+            continue;
+        }
+        memcpy(&start, range, sizeof(start));
+        memcpy(&size, range + 1, sizeof(size));
+        if (!size || start < ram_base || start > (u64)-1 - size ||
+            start + size > ram_base + mem_size_actual || ((start | size) & (get_page_size() - 1)) ||
+            mcc_carveout_count >= ARRAY_SIZE(mcc_carveouts) - 1) {
+            printf("MMU: %s bad bounds 0x%lx+0x%lx, left mapped\n", mcc_adt_tz_names[i], start,
+                   size);
+            continue;
+        }
+        printf("MMU: Unmapping %s (TZ, ADT) at 0x%lx..0x%lx\n", mcc_adt_tz_names[i], start,
+               start + size);
+        mmu_rm_mapping(start, size);
+        mmu_rm_mapping(start | REGION_RWX_EL0, size);
+        mmu_rm_mapping(start | REGION_RW_EL0, size);
+        mmu_rm_mapping(start | REGION_RX_EL1, size);
+        mcc_carveouts[mcc_carveout_count].base = start;
+        mcc_carveouts[mcc_carveout_count].size = size;
+        mcc_carveout_count++;
+    }
+    return 0;
+}
+
+/* smp2h: SError diagnostic. Name the ADT carveout holding an L2C_ERR_ADR (PA = bits [41:0]). */
+void mcc_describe_l2c_adr(u64 adr)
+{
+    u64 pa = adr & GENMASK(41, 0);
+    int node = adt ? adt_path_offset(adt, "/chosen/carveout-memory-map") : -1;
+    const char *hit = NULL;
+
+    for (size_t i = 0; i < mcc_carveout_count; i++)
+        if (pa >= mcc_carveouts[i].base && pa - mcc_carveouts[i].base < mcc_carveouts[i].size)
+            printf("L2C_ERR_ADR PA 0x%lx is in an unmapped TZ carveout (0x%lx+0x%lx)\n", pa,
+                   mcc_carveouts[i].base, mcc_carveouts[i].size);
+    if (node < 0)
+        return;
+    ADT_FOREACH_PROPERTY(adt, node, prop)
+    {
+        if (prop->size != 2 * sizeof(u64) || strncmp(prop->name, "region-id-", 10))
+            continue;
+        u64 r[2];
+        memcpy(r, prop->value, sizeof(r));
+        if (pa >= r[0] && pa - r[0] < r[1]) {
+            hit = prop->name;
+            printf("L2C_ERR_ADR PA 0x%lx: %s 0x%lx..0x%lx\n", pa, hit, r[0], r[0] + r[1]);
+        }
+    }
+    if (!hit)
+        printf("L2C_ERR_ADR PA 0x%lx: in no carveout-memory-map region\n", pa);
+}
+
 int mcc_unmap_carveouts(void)
 {
-    if (!mcc_initialized)
+    if (!mcc_initialized) {
+        if (chip_id == T6050) {
+            mcc_carveout_count = 0;
+            memset(mcc_carveouts, 0, sizeof mcc_carveouts);
+            return mcc_unmap_adt_tz();
+        }
         return -1;
+    }
 
     mcc_carveout_count = 0;
     memset(mcc_carveouts, 0, sizeof mcc_carveouts);
