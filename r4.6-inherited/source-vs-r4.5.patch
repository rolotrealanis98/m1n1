+static int mcc_unmap_adt_tz(void)
+{
+    int node = adt_path_offset(adt, "/chosen/carveout-memory-map");
+
+    if (node < 0) {
+        printf("MMU: no /chosen/carveout-memory-map, TZ carveouts stay mapped\n");
+        return -1;
+    }
+    if (mem_size_actual > (u64)-1 - ram_base)
+        return -1;
+    for (size_t i = 0; i < ARRAY_SIZE(mcc_adt_tz_names); i++) {
+        u32 len;
+        const u64 *range = adt_getprop(adt, node, mcc_adt_tz_names[i], &len);
+        u64 start, size;
+
+        if (!range || len != 2 * sizeof(u64)) {
+            printf("MMU: %s missing, left mapped\n", mcc_adt_tz_names[i]);
+            continue;
+        }
+        memcpy(&start, range, sizeof(start));
+        memcpy(&size, range + 1, sizeof(size));
+        if (!size || start < ram_base || start > (u64)-1 - size ||
+            start + size > ram_base + mem_size_actual || ((start | size) & (get_page_size() - 1)) ||
+            mcc_carveout_count >= ARRAY_SIZE(mcc_carveouts) - 1) {
+            printf("MMU: %s bad bounds 0x%lx+0x%lx, left mapped\n", mcc_adt_tz_names[i], start,
+                   size);
+            continue;
+        }
+        printf("MMU: Unmapping %s (TZ, ADT) at 0x%lx..0x%lx\n", mcc_adt_tz_names[i], start,
+               start + size);
+        mmu_rm_mapping(start, size);
+        mmu_rm_mapping(start | REGION_RWX_EL0, size);
+        mmu_rm_mapping(start | REGION_RW_EL0, size);
+        mmu_rm_mapping(start | REGION_RX_EL1, size);
+        mcc_carveouts[mcc_carveout_count].base = start;
+        mcc_carveouts[mcc_carveout_count].size = size;
+        mcc_carveout_count++;
+    }
+    return 0;
+}
