+bool s1_nvme_access(struct s1_model *m,u32 off,unsigned bytes,bool write,u64 *value)
+{
+    if ((bytes!=4 && bytes!=8) || off%bytes) return false;
+    if (off>=NVME_DBS) {
+        if(bytes!=4 || off>=NVME_DBS+8*VNVME_MAX_QUEUES) return false;
+        if(write) return doorbell_write(m,(off-NVME_DBS)/4,(u32)*value);
+        *value=0;return true;
+    }
+    u32 base=off;
+    bool wide=false;
+    for (unsigned i=0;i<3;i++) {
+        const u32 reg[]={NVME_CAP,NVME_ASQ,NVME_ACQ};
+        if(off==reg[i] || off==reg[i]+4){base=reg[i];wide=true;break;}
+    }
+    if(bytes==8 && (!wide || base!=off)) return false;
+    if(!write) {
+        u64 v=register_value(m,base);
