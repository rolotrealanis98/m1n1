+    if(base==NVME_ASQ || base==NVME_ACQ) {
+        if(m->regs.cc&S1_CC_EN) return false;
+        u64 *r=base==NVME_ASQ?&m->regs.asq:&m->regs.acq;
+        if(bytes==8)*r=*value;
+        else {unsigned shift=(off-base)*8;*r=(*r&~(UINT64_C(0xffffffff)<<shift))|((u64)(u32)*value<<shift);}
